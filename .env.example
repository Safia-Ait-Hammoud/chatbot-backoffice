# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Application Configuration
APP_NAME=Chatbot Backoffice API
APP_VERSION=0.1.0
DEBUG=True

# Project to S3 Bucket Mapping (format: project_id:bucket_name,project_id:bucket_name)
# Example: project1:bucket-project1,project2:bucket-project2
PROJECT_BUCKET_MAPPING=project1:my-chatbot-bucket-project1,project2:my-chatbot-bucket-project2
